[mysqld]
character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci

# Slow query log is cheap and handy when profiling extensions
slow_query_log = 1
slow_query_log_file = /var/lib/mysql/slow.log
long_query_time = 1

# The general log records *every* query and grows without bound.
# Turn it on only while debugging, e.g.:
#   docker compose exec db mysql -uroot -ppassword -e "SET GLOBAL general_log = 1"
general_log = 0
general_log_file = /var/lib/mysql/general.log
